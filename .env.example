# ========================================================
# SUPABASE CLOUD CONFIG (Storage & Database)
# ========================================================
# 1. Tạo project miễn phí tại https://supabase.com
# 2. Vào SQL Editor, dán nội dung từ file `supabase-schema.sql` và bấm RUN
# 3. Lấy URL và Anon Key từ: Project Settings -> API và dán vào bên dưới:

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional (Khuyên dùng để server bypass RLS):
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
